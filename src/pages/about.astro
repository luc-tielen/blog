---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="FP -> Compilers -> Logic -> Blog" canonical="https://luctielen.com/about/">
  <div class="about">
    <h1>Luc Tielen</h1>
    <p>
      I'm a freelance software engineer from Belgium passionate about functional programming,
      compilers and logic. Currently having fun building the{' '}
      <a href="https://github.com/luc-tielen/eclair-lang">eclair programming language</a>, an
      experimental high-performance Datalog. When I'm not tinkering on compilers, I spend most of
      my free time exploring on my bike or going for a walk with my dog.
    </p>
    <p>
      You can reach out to me on <a href="https://twitter.com/luctielen">Twitter</a>. My code can
      be found on <a href="https://github.com/luc-tielen">Github</a>. If you like my open source
      work or the articles on this blog,{' '}
      <a href="https://github.com/sponsors/luc-tielen?o=sd&sc=t">consider sponsoring me</a>.
    </p>
  </div>
</BaseLayout>
